<!-- Splash screen icon: the crescent rises a little and fades in — a moonrise, not a logo reveal.
     Authored on the 288dp canvas the platform expects for a splash icon without an icon
     background; the artwork's ~131dp bounding circle stays inside the visible inner 192dp even at
     the start of the rise. The transform is the launcher foreground's 1.78x scaled by 288/108, so
     the moon is the same size and sits in the same place on the splash as it does in the icon.
     Total run time is 700ms, comfortably under the 1000ms the platform allows a splash animation
     before it cuts it off. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <!-- "rise" carries the animation; the inner group is the static transform that places
                 the 32x32 crescent artwork. -->
            <group android:name="rise">
                <group
                    android:scaleX="4.75"
                    android:scaleY="4.75"
                    android:translateX="59.63"
                    android:translateY="57.04">
                    <path
                        android:name="moon_body"
                        android:fillAlpha="0"
                        android:fillColor="#FCD53F"
                        android:pathData="M23.4106 5.63236C23.9106 7.67236 23.9706 9.89235 23.4306 12.1924C22.1706 17.5224 17.7906 21.7024 12.4106 22.6724C9.50056 23.2024 6.73057 22.8024 4.32056 21.7524C3.76056 21.5024 3.23056 22.1424 3.52056 22.6824C6.17057 27.5624 11.6306 30.6824 17.7406 29.8724C23.9706 29.0424 28.9606 23.9624 29.7106 17.7224C30.3106 12.5424 28.1106 7.86236 24.4306 4.97236C23.9606 4.61236 23.2706 5.05236 23.4106 5.63236Z" />
                    <path
                        android:name="moon_craters"
                        android:fillAlpha="0"
                        android:fillColor="#F9C23C"
                        android:pathData="M27.8706 12.5623C27.8706 13.4294 27.1677 14.1323 26.3006 14.1323C25.4335 14.1323 24.7306 13.4294 24.7306 12.5623C24.7306 11.6952 25.4335 10.9923 26.3006 10.9923C27.1677 10.9923 27.8706 11.6952 27.8706 12.5623ZM14.9505 25.4423C14.9505 26.3094 14.2476 27.0123 13.3805 27.0123C12.5135 27.0123 11.8105 26.3094 11.8105 25.4423C11.8105 24.5752 12.5135 23.8723 13.3805 23.8723C14.2476 23.8723 14.9505 24.5752 14.9505 25.4423ZM26.8005 18.9723C27.3473 18.9723 27.7905 18.5291 27.7905 17.9823C27.7905 17.4355 27.3473 16.9923 26.8005 16.9923C26.2538 16.9923 25.8105 17.4355 25.8105 17.9823C25.8105 18.5291 26.2538 18.9723 26.8005 18.9723ZM24.8005 21.9823C24.8005 23.6392 23.4574 24.9823 21.8005 24.9823C20.1437 24.9823 18.8005 23.6392 18.8005 21.9823C18.8005 20.3254 20.1437 18.9823 21.8005 18.9823C23.4574 18.9823 24.8005 20.3254 24.8005 21.9823Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="rise">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="700"
                android:interpolator="@android:interpolator/decelerate_quint"
                android:propertyName="translateY"
                android:valueFrom="22"
                android:valueTo="0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="moon_body">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="480"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="moon_craters">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="480"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
