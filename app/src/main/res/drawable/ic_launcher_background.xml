<!-- Adaptive-icon background: the app's pure-black canvas (AppBlack) with a soft bloom in the
     signature indigo (AccentIndigo) behind the crescent, so the icon has some depth on a dark
     wallpaper instead of reading as a flat black disc. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF000000"
        android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="60"
                android:startColor="#662C1AB0"
                android:centerColor="#2E2C1AB0"
                android:endColor="#002C1AB0" />
        </aapt:attr>
    </path>
</vector>
