<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+). Covers BOTH transfer paths:

   - <cloud-backup>   Google Auto Backup
   - <device-transfer> direct device-to-device transfer

   Both exclude the key material and the database, for the reasons documented
   in backup_rules.xml. device-transfer is excluded as well as cloud-backup:
   the AndroidKeyStore MasterKey is not transferred either way, so a copied
   secret_shared_prefs is undecryptable on the target device regardless — and
   shipping the PIN wrap anywhere it isn't needed only widens the attack
   surface against a 6-digit PIN.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secret_shared_prefs.xml" />
        <exclude domain="database" path="notes.db" />
        <exclude domain="database" path="notes.db-wal" />
        <exclude domain="database" path="notes.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secret_shared_prefs.xml" />
        <exclude domain="database" path="notes.db" />
        <exclude domain="database" path="notes.db-wal" />
        <exclude domain="database" path="notes.db-shm" />
    </device-transfer>
</data-extraction-rules>
